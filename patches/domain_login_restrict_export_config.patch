diff --git a/domain_login_restrict.install b/domain_login_restrict.install
new file mode 100644
index 0000000000000000000000000000000000000000..10c8b8abf08b7ff2bbc11f56f1dc72b5873e7f19
--- /dev/null
+++ b/domain_login_restrict.install
@@ -0,0 +1,35 @@
+<?php
+
+/**
+ * @file
+ * Contains domain_login_restrict.install.
+ */
+
+/**
+ * Move module config from state to configuration.
+ */
+function domain_login_restrict_update_9501() {
+  $state = \Drupal::state();
+  $config_factory = \Drupal::configFactory();
+  $config = $config_factory->getEditable('domain_login_restrict.settings');
+
+  $statesToRemove = [];
+
+  $config->set('domain_login_restrict_enabled', $state->get('domain_login_restrict_enabled'));
+  $statesToRemove[] = 'domain_login_restrict_enabled';
+  $config->set('domain_login_restrict_assign_domain', $state->get('domain_login_restrict_assign_domain'));
+  $statesToRemove[] = 'domain_login_restrict_assign_domain';
+
+  $domain_ids = \Drupal::entityTypeManager()->getStorage('domain')->getQuery()
+    ->accessCheck(FALSE)
+    ->execute();
+  foreach ($domain_ids as $domain_id) {
+    $config->set('domain_login_restrict_role_' . $domain_id, $state->get('domain_login_restrict_role_' . $domain_id));
+    $statesToRemove[] = 'domain_login_restrict_role_' . $domain_id;
+    $config->set('domain_login_restrict_assign_role_' . $domain_id, $state->get('domain_login_restrict_assign_role_' . $domain_id));
+    $statesToRemove[] = 'domain_login_restrict_assign_role_' . $domain_id;
+  }
+
+  $config->save(TRUE);
+  $state->deleteMultiple($statesToRemove);
+}

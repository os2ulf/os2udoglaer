<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\layout_builder\Form\ConfigureSectionForm;
use Drupal\os2uol_domain\Os2uolDomain;
use Drupal\transform_api\Transform\EntityTransform;
use Drupal\transform_api_views\Transform\ViewTransform;

const OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID = 'anchor_id';

/**
 * Implements hook_form_BASE_FORM_ID_alter() for layout_builder_configure_section.
 */
function os2uol_transform_plugins_form_layout_builder_configure_section_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof ConfigureSectionForm) {
    return;
  }

  $anchor_id = $form_object
    ->getCurrentSection()
    ->getThirdPartySetting('os2uol_transform_plugins', OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID, '');

  $form['os2uol_transform_plugins'] = [
    '#type' => 'container',
    '#weight' => 50,
  ];
  $form['actions']['#weight'] = 100;
  $form['os2uol_transform_plugins'][OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID] = [
    '#type' => 'textfield',
    '#title' => t('Anchor ID'),
    '#default_value' => $anchor_id,
    '#description' => t('Used as the URL fragment for linking to this section, for example #program. Use letters, numbers, underscores, and hyphens. The first character must be a letter.'),
    '#maxlength' => 128,
    '#attributes' => [
      'pattern' => '[A-Za-z][A-Za-z0-9_-]*',
    ],
  ];

  $form['#validate'][] = 'os2uol_transform_plugins_layout_builder_section_anchor_validate';

  $submit_handler = 'os2uol_transform_plugins_layout_builder_section_anchor_submit';
  $submit_handlers = array_values(array_filter($form['#submit'] ?? [], static function ($callback) use ($submit_handler) {
    return $callback !== $submit_handler;
  }));
  $core_submit_position = array_search('::submitForm', $submit_handlers, TRUE);
  if ($core_submit_position === FALSE) {
    $submit_handlers[] = $submit_handler;
  }
  else {
    array_splice($submit_handlers, $core_submit_position, 0, [$submit_handler]);
  }
  $form['#submit'] = $submit_handlers;
}

/**
 * Validates the section anchor ID.
 */
function os2uol_transform_plugins_layout_builder_section_anchor_validate(array &$form, FormStateInterface $form_state): void {
  $anchor_id = trim((string) $form_state->getValue(['os2uol_transform_plugins', OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID], ''));
  if ($anchor_id === '') {
    return;
  }

  if (!preg_match('/^[A-Za-z][A-Za-z0-9_-]*$/', $anchor_id)) {
    $form_state->setError(
      $form['os2uol_transform_plugins'][OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID],
      t('The anchor ID must start with a letter and only contain letters, numbers, underscores, and hyphens.')
    );
    return;
  }

  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof ConfigureSectionForm) {
    return;
  }

  $build_info = $form_state->getBuildInfo();
  $current_delta = $build_info['args'][1] ?? NULL;
  $plugin_id = $build_info['args'][2] ?? NULL;
  $is_update = $plugin_id === NULL;

  foreach ($form_object->getSectionStorage()->getSections() as $delta => $section) {
    if ($is_update && (string) $delta === (string) $current_delta) {
      continue;
    }

    $existing_anchor_id = $section->getThirdPartySetting('os2uol_transform_plugins', OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID);
    if ($existing_anchor_id === $anchor_id) {
      $form_state->setError(
        $form['os2uol_transform_plugins'][OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID],
        t('The anchor ID must be unique on this page.')
      );
      return;
    }
  }
}

/**
 * Stores the section anchor ID before Layout Builder saves the section.
 */
function os2uol_transform_plugins_layout_builder_section_anchor_submit(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof ConfigureSectionForm) {
    return;
  }

  $anchor_id = trim((string) $form_state->getValue(['os2uol_transform_plugins', OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID], ''));
  $section = $form_object->getCurrentSection();
  if ($anchor_id === '') {
    $section->unsetThirdPartySetting('os2uol_transform_plugins', OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID);
    return;
  }

  $section->setThirdPartySetting('os2uol_transform_plugins', OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID, $anchor_id);
}

function os2uol_transform_plugins_block_content_transform_alter(&$transformation): void {
  if (empty($transformation)) {
    return;
  }

  if ($transformation['bundle'] == 'appetizer') {
    $transform_mode = 'small';
    if ($transformation['transform_mode'] === 'width_100') {
      $transform_mode = 'default';
    }

    $transformation['appetizer_size'] = $transform_mode;
  }

  if ($transformation['bundle'] == 'application_form') {
    $domain_array = [];

    /** @var \Drupal\domain\DomainNegotiator $domain_negotiator */
    $domain_negotiator = \Drupal::service('domain.negotiator');

    // Add current and default domain to transformation.
    $domain_array[] = $domain_negotiator->getActiveId();

    if ($domain_negotiator->getActiveId() !== Os2uolDomain::DEFAULT_DOMAIN_ID) {
      $domain_array[] = Os2uolDomain::DEFAULT_DOMAIN_ID;
    }

    $transformation['field_domain_access'] = $domain_array;
  }
}

function os2uol_transform_plugins_node_transform_alter(&$transformation) {
  if (empty($transformation)) {
    return;
  }

  /** @var \Drupal\node\Entity\Node $node */
  $node = $transformation['#entity'];

  // Check if user role is provider.
  if ($node->get('uid')->entity->hasRole('course_provider')) {
    // Add user transform object to transformation.
    $transformation['provider'] = new EntityTransform($node->get('uid')->entity, 'courses');
  }
  // Check if user role is provider.
  if ($node->get('uid')->entity->hasRole('corporation')) {
    // Add user transform object to transformation.
    $transformation['corporation'] = new EntityTransform($node->get('uid')->entity, 'courses');
  }
  // Add entity link to transformation.
  $transformation['link'] = $node->toUrl()->toString();
  // Add entity bundle label to transformation.
  $transformation['bundle_label'] = $node->type->entity->label();
  // Add created date formatted with os2date to transformation.
  $transformation['created'] = \Drupal::service('date.formatter')->format($node->get('created')->value, 'os2date');

  // Check if transformation is full and set is_frontpage variable if current page is set as frontpage.
  if ($transformation['transform_mode'] === 'full') {
    if (\Drupal::config('system.site')->get('page.front') === '/node/' . $node->id()) {
      $transformation['is_frontpage'] = TRUE;
    } else {
      $transformation['is_frontpage'] = FALSE;
    }
  }
}

/**
 * Implements hook_TRANSFORM_TYPE_transform_alter().
 */
function os2uol_transform_plugins_section_transform_alter(&$transformation) {
  $anchor_id = $transformation['third_party_settings']['os2uol_transform_plugins'][OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID] ?? NULL;
  if (!empty($anchor_id)) {
    $transformation['layout_settings'][OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID] = $anchor_id;
    unset($transformation['third_party_settings']['os2uol_transform_plugins'][OS2UOL_TRANSFORM_PLUGINS_SECTION_ANCHOR_ID]);

    if (empty($transformation['third_party_settings']['os2uol_transform_plugins'])) {
      unset($transformation['third_party_settings']['os2uol_transform_plugins']);
    }
  }

  foreach ($transformation['regions'] as $region => $components) {
    foreach ($components as &$component) {
      os2uol_transform_plugins_layout_blocks_pre_transform($component);
    }
  }
}

function os2uol_transform_plugins_layout_blocks_pre_transform(&$block_transform): void {
  if ($block_transform instanceof EntityTransform) {
    $entity = $block_transform->getEntity();

    // Handle dynamic image styles for image block.
    if ($entity->getEntityTypeId() == 'block_content' && $entity->bundle() == 'image') {
      if ($entity->get('field_dynamic_height')->value) {
        $transform_mode = $block_transform->getValue('transform_mode');

        $new_transform_mode = $transform_mode . '_dynamic';

        $block_transform->setValue('transform_mode', $new_transform_mode);
        $block_transform->setTransformMode($new_transform_mode);
      }
    }
  }
}

function os2uol_transform_plugins_user_transform_alter(&$transformation) {
  if (empty($transformation)) {
    return;
  }

  /** @var \Drupal\user\Entity\User $user */
  $user = $transformation['#entity'];

  // Add user profile link and user roles to transformation.
  $transformation['link'] = $user->toUrl()->toString();
  $transformation['roles'] = $user->getRoles();

  $roles = $user->getRoles(TRUE);
  $role_id = reset($roles) ?? NULL;

  // Add user role label to transformation as bundle label.
  if ($role_id) {
    $role = \Drupal::entityTypeManager()->getStorage('user_role')->load($role_id);
    $transformation['bundle_label'] = $role->label();
  }

  if (in_array($transformation['transform_mode'], ['default', 'full'])) {
    // Add related content
    $transformation['related_content'] = new ViewTransform('related_content', 'block_1');
  }
}

function os2uol_transform_plugins_view_latest_news_block_1_transform_alter(&$transformation) {
  if (empty($transformation)) {
    return;
  }
  $transformation['entity_type'] = 'block_content';
  $transformation['bundle'] = $transformation['view_id'];
}

/**
 * Implements hook_HOOK_transform_alter().
 */
function os2uol_transform_plugins_view_content_search_transform_alter(&$transformation) {
  if (!str_starts_with($transformation['display_id'], 'block_')) {
    return;
  }
  $transformation['entity_type'] = 'block_content';
  $transformation['bundle'] = $transformation['view_id'];
}

/**
 * Implements hook_HOOK_transform_alter().
 */
function os2uol_transform_plugins_view_course_providers_transform_alter(&$transformation) {
  if (!str_starts_with($transformation['display_id'], 'block_')) {
    return;
  }
  $transformation['entity_type'] = 'block_content';
  $transformation['bundle'] = $transformation['view_id'];
}

/**
 * Implements hook_HOOK_transform_alter().
 */
function os2uol_transform_plugins_view_transform_alter(&$transformation) {
  if (!empty($transformation['exposed_filters']['sort_by'])) {
    $transformation['exposed_filters']['sort_by']['default_value'] = $transformation['exposed_filters']['sort_by']['value'];
    unset($transformation['exposed_filters']['sort_by']['value']);
  }
}

/**
 * Implements hook_views_post_build().
 */
function os2uol_transform_plugins_views_post_build(\Drupal\views\ViewExecutable $view): void {
  if ($view->id() == 'related_content') {
    $options = $view->exposed_widgets['target_group']['#options'];

    foreach ($options as $key => $option) {
      if ($key == 'All') {
        continue;
      }

      $new_option = t('Progress to @option', ['@option' => strtolower($option)]);

      $view->exposed_widgets['target_group']['#options'][$key] = $new_option;
    }
  }
}

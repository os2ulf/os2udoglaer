msgid "Delete"
msgstr "Slet"

msgid "Delete content"
msgstr "Slet indhold"

msgid "Delete @entity_label"
msgstr "Slet @entity_label"

msgid "Are you sure you want to delete %label?"
msgstr "Er du sikker på, at du vil slette %label?"

msgid "The content can be restored from the trash until it is automatically purged."
msgstr "Indholdet kan gendannes fra papirkurven, indtil det automatisk slettes permanent."

msgid "The content could not be deleted."
msgstr "Indholdet kunne ikke slettes."

msgid "%label has been deleted."
msgstr "%label er blevet slettet."

msgid "Are you sure you want to delete this content item?"
msgid_plural "Are you sure you want to delete these content items?"
msgstr[0] "Er du sikker på, at du vil slette dette indhold?"
msgstr[1] "Er du sikker på, at du vil slette disse indholdselementer?"

msgid "Deleted @count content item."
msgid_plural "Deleted @count content items."
msgstr[0] "Slettede @count indholdselement."
msgstr[1] "Slettede @count indholdselementer."

msgid "@count content item could not be deleted."
msgid_plural "@count content items could not be deleted."
msgstr[0] "@count indholdselement kunne ikke slettes."
msgstr[1] "@count indholdselementer kunne ikke slettes."

<?php

/**
 * @file
 * Primary module hooks for OS2UOL Users module.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Cache\Cache;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;
use Drupal\views\Views;
use Drupal\user\UserInterface;

/**
 * Implements hook_module_implements_alter().
 */
function os2uol_users_module_implements_alter(&$implementations, $hook) {
  if ($hook === 'user_cancel') {
    // Drupal core's node_user_cancel() loads and saves all historical node
    // revisions owned by the deleted account. With content moderation this can
    // turn an old revision into current content, overwriting a later author
    // reassignment and publication state. os2uol_users_user_cancel() replaces
    // only the node-specific account cancellation handling below.
    unset($implementations['node']);
  }
}

/**
 * Implements hook_user_cancel().
 */
function os2uol_users_user_cancel($edit, UserInterface $account, $method) {
  switch ($method) {
    case 'user_cancel_block_unpublish':
      // Match core node behavior for this cancellation method.
      $nids = \Drupal::entityQuery('node')
        ->accessCheck(FALSE)
        ->condition('uid', $account->id())
        ->execute();
      \Drupal::moduleHandler()->loadInclude('node', 'inc', 'node.admin');
      node_mass_update($nids, ['status' => 0], NULL, TRUE);
      break;

    case 'user_cancel_reassign':
      _os2uol_users_reassign_node_authorship_to_anonymous($account);
      break;
  }
}

/**
 * Reassigns node authorship data for a cancelled user without saving nodes.
 */
function _os2uol_users_reassign_node_authorship_to_anonymous(UserInterface $account): void {
  $uid = (int) $account->id();
  if ($uid <= 0) {
    return;
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $node_entity_type = $entity_type_manager->getDefinition('node');
  $connection = \Drupal::database();

  $nid_key = $node_entity_type->getKey('id');
  $owner_key = $node_entity_type->getKey('owner');
  $revision_user_key = $node_entity_type->getRevisionMetadataKey('revision_user');
  $data_table = $node_entity_type->getDataTable();
  $revision_data_table = $node_entity_type->getRevisionDataTable();
  $revision_table = $node_entity_type->getRevisionTable();

  $affected_nids = array_unique(array_merge(
    _os2uol_users_node_ids_referencing_user($data_table, $nid_key, $owner_key, $uid),
    _os2uol_users_node_ids_referencing_user($revision_data_table, $nid_key, $owner_key, $uid),
    _os2uol_users_node_ids_referencing_user($revision_table, $nid_key, $revision_user_key, $uid)
  ));

  $transaction = $connection->startTransaction();
  try {
    $connection->update($data_table)
      ->fields([$owner_key => 0])
      ->condition($owner_key, $uid)
      ->execute();

    $connection->update($revision_data_table)
      ->fields([$owner_key => 0])
      ->condition($owner_key, $uid)
      ->execute();

    $connection->update($revision_table)
      ->fields([$revision_user_key => 0])
      ->condition($revision_user_key, $uid)
      ->execute();

    _os2uol_users_anonymize_node_moderation_state_owners($uid);
  }
  catch (\Throwable $e) {
    $transaction->rollBack();
    throw $e;
  }
  unset($transaction);

  _os2uol_users_invalidate_reassigned_nodes($affected_nids);
}

/**
 * Gets node IDs where a table column references a user ID.
 */
function _os2uol_users_node_ids_referencing_user(string $table, string $nid_key, string $uid_key, int $uid): array {
  if (!$table) {
    return [];
  }

  return \Drupal::database()
    ->select($table, 't')
    ->distinct()
    ->fields('t', [$nid_key])
    ->condition($uid_key, $uid)
    ->execute()
    ->fetchCol();
}

/**
 * Anonymizes internal moderation-state owner records for node content.
 */
function _os2uol_users_anonymize_node_moderation_state_owners(int $uid): void {
  if (!\Drupal::moduleHandler()->moduleExists('content_moderation')) {
    return;
  }

  $connection = \Drupal::database();
  $schema = $connection->schema();
  foreach (['content_moderation_state_field_data', 'content_moderation_state_field_revision'] as $table) {
    if (!$schema->tableExists($table)) {
      continue;
    }

    $connection->update($table)
      ->fields(['uid' => 0])
      ->condition('uid', $uid)
      ->condition('content_entity_type_id', 'node')
      ->execute();
  }
}

/**
 * Clears entity caches and queues affected nodes for Search API reindexing.
 */
function _os2uol_users_invalidate_reassigned_nodes(array $nids): void {
  $nids = array_values(array_unique(array_filter(array_map('intval', $nids))));
  if (!$nids) {
    return;
  }

  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $module_handler = \Drupal::moduleHandler();
  $track_search = $module_handler->moduleExists('search_api');
  $tracking_manager = $track_search ? \Drupal::service('search_api.entity_datasource.tracking_manager') : NULL;
  $tracking_helper = $track_search ? \Drupal::service('search_api.tracking_helper') : NULL;

  foreach (array_chunk($nids, 100) as $nid_chunk) {
    $node_storage->resetCache($nid_chunk);

    $cache_tags = ['node_list'];
    foreach ($nid_chunk as $nid) {
      $cache_tags[] = "node:$nid";
    }
    Cache::invalidateTags($cache_tags);

    if (!$track_search) {
      continue;
    }

    $nodes = $node_storage->loadMultiple($nid_chunk);
    foreach ($nodes as $node) {
      $tracking_manager->entityUpdate($node);
      $tracking_helper->trackReferencedEntityUpdate($node);
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_access().
 */
function os2uol_users_user_access(\Drupal\user\UserInterface $user, $operation, \Drupal\Core\Session\AccountInterface $current_user) {
  $has_allowed_role = os2uol_user_has_allowed_role($user);
  $is_on_current_domain = os2uol_user_is_on_current_domain($user);

  // If the user has any of the allowed roles and is on the current domain, return neutral.
  if ($has_allowed_role && $is_on_current_domain) {
    return AccessResult::neutral();
  }

  // If current user does not have permission to view private user information, return forbidden.
  if (!$current_user->hasPermission('view private user information')) {
    return AccessResult::forbidden();
  }

  return AccessResult::neutral();
}

/**
 * Checks whether the user is on the current domain.
 *
 * @param $user
 *
 * @return bool
 */
function os2uol_user_is_on_current_domain($user): bool {
  /** @var \Drupal\domain\DomainNegotiatorInterface $domain_negotiator */
  $domain_negotiator = \Drupal::service('domain.negotiator');
  $current_domain_id = $domain_negotiator->getActiveId();

  $user_domains = array_column($user->get('field_domain_access')->getValue(), 'target_id');
  return in_array($current_domain_id, $user_domains);
}

/**
 * Checks whether the user has any of the allowed roles.
 *
 * @param $user
 *
 * @return bool
 */
function os2uol_user_has_allowed_role($user): bool {
  $allowed_roles = os2uol_get_public_user_roles();
  $user_roles = $user->getRoles(TRUE);

  return !empty(array_intersect($user_roles, $allowed_roles));
}

function os2uol_get_public_user_roles(): array {
  return [
    'course_provider',
    'place_of_visit',
    'corporation',
    'institution',
    'school',
    'theater_contact'
  ];
}

/**
 * Implements hook_form_alter() to hide the field_roles field for non-admin users.
 */
function os2uol_users_form_user_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Get the current user.
  $current_user = \Drupal::currentUser();


  // Check if the current user has the corporation role.
  $has_corporation_role = $current_user->hasRole('corporation');

  // If the user has corporation role, hide the field_guarantee_partner field.
  if ($has_corporation_role) {
    if (isset($form['field_guarantee_partner'])) {
      $form['field_guarantee_partner']['#access'] = FALSE;
    }
  }
}

/**
 * Implements hook_views_query_alter().
 */
function os2uol_users_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  // Check if the view is a Workbench dashboard view.
  if ($view->id() == 'workbench_recent_content') {
    // Get the current user.
    $current_user = \Drupal::currentUser();

    // Get the roles of the current user.
    $roles = $current_user->getRoles();

    // Check if the user has the 'administrator', 'webmaster', or 'editor' role.
    if (in_array('administrator', $roles) || in_array('webmaster', $roles) || in_array('editor', $roles)) {
      // If the user has any of these roles, do not alter the query.
      return;
    }

    // Add a join to the 'node_field_data' table.
    $join = Views::pluginManager('join')->createInstance('standard', [
      'table' => 'node_field_data',
      'field' => 'nid',
      'left_table' => 'node_field_data',
      'left_field' => 'nid',
      'operator' => '=',
    ]);
    $query->addRelationship('node_field_data', $join, 'node_field_data');

    // Add a condition to the query to exclude entities of type "page".
    $query->addWhere(0, 'node_field_data.type', 'page', '!=');

    // Add a condition to the query to only include nodes where the author (uid) is the current user.
    $query->addWhere(0, 'node_field_data.uid', $current_user->id());
  }
}

#!/bin/bash

## Description: Local update script
## Usage: local_update
## Example: ddev local_update

set -euo pipefail

ddev composer install
# Core updates must add new router columns before a full cache rebuild.
ddev drush updb -y
ddev drush cr
ddev drush cim -y
ddev drush cr
ddev drush deploy:hook -y
ddev drush cr
ddev drush locale-check
ddev drush locale-update
ddev drush cr

{
    "name": "novicell/drupal-premium",
    "description": "Novicell Drupal Premium package for Drupal 9 projects",
    "type": "project",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.dk/php/",
            "canonical": false
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "bower-asset/jquery-simple-color": "^1.2",
        "bower-asset/spectrum": "^1.8",
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.6.5",
        "drupal/admin_toolbar": "^3.4",
        "drupal/allowed_formats": "^3.0",
        "drupal/anchor_link": "^3.0",
        "drupal/atoms": "^1.1",
        "drupal/auto_entitylabel": "^3.3",
        "drupal/autosave_form": "^1.11",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/better_permissions_page": "^1.0",
        "drupal/ckeditor5_paste_filter": "^1.0",
        "drupal/components": "^3.0@beta",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_filter": "^2.7",
        "drupal/config_ignore": "^3.3",
        "drupal/config_split": "^2.0",
        "drupal/content_moderation_bypass": "^1.0@alpha",
        "drupal/content_moderation_notifications": "^3.6",
        "drupal/core-composer-scaffold": "^11.3",
        "drupal/core-project-message": "^11.3",
        "drupal/core-recommended": "^11.3",
        "drupal/core-vendor-hardening": "^11.3",
        "drupal/date_popup": "^2.0",
        "drupal/diff": "^2.1",
        "drupal/domain": "~2.0.0",
        "drupal/domain_access_search_api": "^1.0",
        "drupal/domain_entity": "^2.0",
        "drupal/domain_login_restrict": "^1.4",
        "drupal/domain_menus": "^3.7",
        "drupal/domain_simple_sitemap": "^3.0@RC",
        "drupal/editor_advanced_link": "^2.2",
        "drupal/entity_clone": "^2.0@beta",
        "drupal/entity_usage": "^2.0-beta3",
        "drupal/facets": "^2.0",
        "drupal/field_group": "^4.0",
        "drupal/focal_point": "^2.0",
        "drupal/gin": "^5.0",
        "drupal/gin_toolbar": "^3.0",
        "drupal/health_check": "^3.0",
        "drupal/hreflang": "^1.0",
        "drupal/imageapi_optimize": "^4.2",
        "drupal/inline_block_title_automatic": "^2.0",
        "drupal/jquery_once": "^1.1",
        "drupal/layout_builder_at": "^3.0",
        "drupal/layout_builder_modal": "^1.0",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupal/layoutbuilder_search_api": "^1.0",
        "drupal/linkit": "^7.0",
        "drupal/maxlength": "^3.0@beta",
        "drupal/menu_item_fields": "^1.10",
        "drupal/menu_per_role": "^1.7",
        "drupal/metatag": "^2.1",
        "drupal/noreferrer": "^1.0",
        "drupal/paragraphs": "^1.0",
        "drupal/paragraphs_asymmetric_translation_widgets": "^1.0",
        "drupal/pathauto": "^1.0",
        "drupal/pathologic": "^2.0@alpha",
        "drupal/r4032login": "^2.2",
        "drupal/rdf": "^4.0",
        "drupal/redirect": "^1.0",
        "drupal/redirect_after_login": "^3.0",
        "drupal/redis": "^1.11",
        "drupal/replicate_ui": "^1.2",
        "drupal/restui": "^1.21",
        "drupal/role_delegation": "^1.1",
        "drupal/scheduled_transitions": "^2.8",
        "drupal/search_api": "^1.41",
        "drupal/search_api_exclude_entity": "^3.0",
        "drupal/search_api_page": "^1.0@beta",
        "drupal/search_api_solr": "^4.3",
        "drupal/sendgrid_integration": "^2.2",
        "drupal/sharedemail": "^3.2",
        "drupal/simple_sitemap": "^4.1",
        "drupal/smtp": "^1.2",
        "drupal/symfony_mailer_lite": "^2.0",
        "drupal/transform_api": "^2.1.7",
        "drupal/transform_api_facets": "^2.0@alpha",
        "drupal/ultimate_cron": "^2.0@alpha",
        "drupal/view_unpublished": "^1.0",
        "drupal/views_base_url": "^2.1",
        "drupal/views_bulk_operations": "^4.4",
        "drupal/views_cm_current_state": "^2.1",
        "drupal/views_contextual_filters_or": "^1.5",
        "drupal/views_data_export": "^1.4",
        "drupal/views_simple_math_field": "^3.0",
        "drupal/webform": "^6.3",
        "drupal/webform_rest": "^4.2",
        "drupal/webp": "^1.0@RC",
        "drupal/workbench": "^1.4",
        "drupal/workbench_reviewer": "^3.0@beta",
        "drupal/workflow_buttons": "^1.0@beta",
        "drupal/xls_serialization": "^1.3",
        "drush/drush": "^13",
        "mglaman/composer-drupal-lenient": "^2.0",
        "novicell/dawa": "^1.0",
        "novicell/dynamic_key_value": "^1.0",
        "novicell/image_style_generator": "^1.0",
        "novicell/premium_core": "^1.0",
        "novicell/premium_headless": "^2.1",
        "novicell/premium_headless_theme": "^1.0",
        "novicell/premium_profile": "^11.1",
        "novicell/premium_search": "^1.0",
        "novicell/premium_tools": "^1.0",
        "novicell/status_feed": "^1.0",
        "novicell/styles": "^1.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "platformsh/config-reader": "^2.4",
        "vlucas/phpdotenv": "^5.3",
        "wikimedia/composer-merge-plugin": "^2.0"
    },
    "require-dev": {
        "drupal/devel": "^5.0",
        "drupal/upgrade_status": "^4.0",
        "kint-php/kint": "^5.1",
        "phpunit/phpunit": "^12.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true,
            "composer/installers": true,
            "wikimedia/composer-merge-plugin": true,
            "oomphinc/composer-installers-extender": true,
            "mglaman/composer-drupal-lenient": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "allowed-packages": [
                "drupal/core"
            ],
            "locations": {
                "web-root": "webroot/"
            },
            "file-mapping": {
                "[web-root]/robots.txt": {
                    "append": "assets/robots-additions.txt"
                },
                "[web-root]/sites/development.services.yml": {
                    "mode": "replace",
                    "path": "assets/development.services.yml",
                    "overwrite": false
                }
            }
        },
        "installer-paths": {
            "webroot/core": [
                "type:drupal-core"
            ],
            "webroot/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset",
                "type:bower-asset"
            ],
            "webroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "webroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "webroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "webroot/drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "webroot/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "webroot/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "installer-types": [
            "npm-asset",
            "bower-asset"
        ],
        "merge-plugin": {
            "include": [
                "webroot/modules/contrib/webform/composer.libraries.json"
            ]
        },
        "patches": {
            "drupal/conditional_fields": {
                "(#2988937) CKEditor required-field fix for alpha6 (reviewed upstream patch, local copy)": "patches/conditional_fields_ckeditor_required.patch"
            },
            "drupal/content_moderation_notifications": {
                "(#2965600) Add content type option": "https://www.drupal.org/files/issues/2026-03-04/2965600-content-type_23.patch",
                "Enable token support for ad-hoc email addresses": "patches/content_moderation_notifications_support_adhoc_token.patch",
                "Turn BCC into To": "patches/content_moderation_notifications_bcc_into_to.patch",
                "Project compatibility: preserve configured ad-hoc recipient access rules": "patches/content_moderation_notifications_preserve_recipient_access.patch"
            },
            "drupal/core": {
                "(#3612050) Resolve legacy route converter IDs during the Drupal 11.4 upgrade": "https://www.drupal.org/files/issues/2026-08-12/3612050-paramconverter-invalid-argument-workaround.patch",
                "(#2999491) Allow creation of reuseable inline blocks": "https://www.drupal.org/files/issues/2024-07-17/drupal-2999491-162.patch",
                "Configure limit method on titles and link fields": "patches/configure_limit_method_on_titles_and_link_fields.patch",
                "Remove link from node updated message": "patches/core_remove_link_from_node_save_message.patch"
            },
            "drupal/diff": {
                "(#3165141) Configure the default revision comparison filter (upstream MR95, 8e40220)": "patches/diff_default_filter.patch",
                "Only show image thumbnails when the field changed": "patches/diff_only_show_changed_image_thumbnails.patch"
            },
            "drupal/domain_login_restrict": {
                "(#3336184) Preserve configuration export on release 1.4 (upstream #12 adapted)": "patches/domain_login_restrict_export_config.patch"
            },
            "drupal/layoutbuilder_search_api": {
                "(#3566471) Drupal 11.3+ trait compatibility (reviewed upstream fix, local copy)": "patches/layoutbuilder_search_api_drupal11_compatibility.patch"
            },
            "drupal/paragraphs": {
                "(#2901390) Integrity constraint violation: 1048 Column 'langcode' cannot be null": "https://www.drupal.org/files/issues/2023-07-20/2901390-9-109.patch"
            },
            "drupal/redis": {
                "(#3337750) Preserve zero-metrics guard on Redis 1.11": "patches/redis_report_zero_metrics.patch"
            },
            "drupal/replicate": {
                "(#3392959) Replicated layout builder blocks don't always have the correct order": "https://git.drupalcode.org/project/replicate/-/merge_requests/8.diff"
            },
            "drupal/scheduled_transitions": {
                "(#3264674) Keep unrelated field groups off the transition form (reviewed upstream patch, local copy)": "patches/scheduled_transitions_form_display.patch"
            },
            "drupal/transform_api": {
                "Fix access check for non-bundled entity types": "patches/transform_api_non_bundled_entity_access_fix.patch"
            },
            "drupal/views_bulk_operations": {
                "(#3422715) Missing checkboxes in 4.2.6 when using Views Data Export": "https://git.drupalcode.org/project/views_bulk_operations/-/merge_requests/79.diff"
            },
            "drupal/workbench": {
                "Apply patch from branch 3484630-mismatched-views-area": "https://git.drupalcode.org/issue/workbench-3484630/-/commit/41ff2be540e760aec54e06cd35c5e5a75e21f502.diff"
            },
            "drupal/workflow_buttons": {
                "(#3451409) Automated Drupal 11 compatibility fixes for workflow_buttons": "https://www.drupal.org/files/issues/2024-11-25/workflow_buttons_3451409_git_theme.patch"
            },
            "novicell/dawa": {
                "Require full address, or none": "patches/dawa_require_full_address_or_none.patch",
                "Project compatibility: Drupal 11 extension metadata and form element base": "patches/dawa_drupal11_compatibility.patch"
            }
        },
        "composer-exit-on-patch-failure": true,
        "drupal-lenient": {
            "allowed-list": [
                "novicell/dawa"
            ]
        }
    }
}
